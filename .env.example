# ═══════════════════════════════════════════
# AI Resume Generator — Environment Variables
# ═══════════════════════════════════════════

# API Keys (set the one matching your model choice)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ═══════════════════════════════════════════
# MODEL SELECTION — change these to switch models
# ═══════════════════════════════════════════
# Writer auto-detects: "gpt-*" uses OpenAI, "claude-*" uses Anthropic
#
# Option A: Both GPT (recommended)
PLANNER_MODEL=gpt-5.4
WRITER_MODEL=gpt-4o
SCORER_MODEL=gpt-5.4
#
# Option B: Claude writes, GPT scores
# WRITER_MODEL=claude-sonnet-4-20250514
# SCORER_MODEL=gpt-4o
#
# Option C: All Claude (needs Anthropic key)
# WRITER_MODEL=claude-sonnet-4-20250514
# SCORER_MODEL=gpt-4o
# ═══════════════════════════════════════════

HOST=0.0.0.0
PORT=8000
